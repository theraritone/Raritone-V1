{
  "name": "raritone-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && npm run check:styles",
    "typecheck": "tsc -b --force && tsc -p tsconfig.server.json --noEmit",
    "check:styles": "node scripts/check-styles.mjs",
    "lint": "npm run typecheck",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node --import tsx server/index.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "verify:live": "node --import tsx scripts/verify-live-vto.ts",
    "serve:check": "node --import tsx scripts/serve-check.ts",
    "dev:check": "node --import tsx scripts/dev-check.ts",
    "verify": "npm run typecheck && npm run smoke && npm run serve:check",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@decartai/sdk": "^0.2.2",
    "@supabase/supabase-js": "^2.58.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "livekit-client": "^2.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
