# Raritone — environment
#
# Copy to .env and fill in only what you need. Every value has a working default,
# so `npm run dev` runs with no .env at all.
#
# Never commit a filled-in .env.

# --- server ---------------------------------------------------------------

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Absolute origin used when generating shareable links. Set this when you want
# share links to point somewhere other than the current host, e.g.
#   PUBLIC_ORIGIN=https://raritone.app
PUBLIC_ORIGIN=

# Where the local driver keeps its JSON + media. Safe to delete to reset.
DATA_DIR=.data

# --- storage --------------------------------------------------------------
#
# Leave these empty to use the on-disk driver. Set all three to switch the
# repository to Postgres + Storage. The service role key is server-side only and
# must never be exposed to the client: do not prefix it with VITE_.
#
# Apply server/supabase/schema.sql to the project first.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if you want the server to mint guest JWTs itself. Optional: the
# service role key is enough for the device-id session flow.
SUPABASE_JWT_SECRET=

SUPABASE_BUCKET_GARMENTS=garments
SUPABASE_BUCKET_MEDIA=media

# --- try-on provider ------------------------------------------------------
#
# TRYON_PROVIDER selects an adapter from server/provider/index.ts.
#   live-vto  — real Decart live sessions, brokered through the
#               raritone-live-vto backend (the default). Needs that backend
#               running (see below) or every try-on start fails with a clear
#               "unavailable" error instead of a fake preview. There is no photo
#               mode on this adapter: the live backend mints realtime sessions
#               only.
#   mock      — local compositing with sharp, no network, no cost. For offline
#               development and hermetic tests (`npm run smoke` pins this).
#               Never ships as the default.
#   http      — template adapter for a generic hosted vendor. Fill in the URL
#               and key below.
#
# The permanent Decart API key lives in the live-vto BACKEND's own .env
# (DECART_API_KEY) — never here, never in the client. This process only ever
# sees short-lived client tokens.

TRYON_PROVIDER=live-vto
TRYON_PROVIDER_BASE_URL=
TRYON_PROVIDER_API_KEY=

# Base URL of the raritone-live-vto backend, which owns Decart session
# creation, heartbeats and teardown. The PWA never talks to Decart directly.
LIVE_VTO_BASE_URL=http://127.0.0.1:4000

# FR-702: disable the provider in production without shipping a new client.
PROVIDER_KILL_SWITCH=false

# --- live and photo limits ------------------------------------------------

LIVE_SESSION_SECONDS=90
LIVE_MAX_EXTENSION_SECONDS=120
LIVE_FPS=12
PHOTO_TIMEOUT_MS=20000
LIVE_START_TIMEOUT_MS=12000

# --- allowances -----------------------------------------------------------
#
# D-04: a guest gets one successful try-on. A guest live session is capped
# separately so a guest can see the effect of a garment without spending their
# photo allowance.

GUEST_PHOTO_ALLOWANCE=1
GUEST_LIVE_SECONDS=30

FREE_PHOTO_ALLOWANCE=10
FREE_LIVE_SECONDS=300

USAGE_WINDOW_HOURS=168

# --- cost guard -----------------------------------------------------------
#
# FR-703. Caps are in cents and stop new work before the limit is exceeded, so
# the worst case is one in-flight job over budget. Every live session start and
# end is also logged to stdout with its timestamp and burned seconds.

COST_CAP_CENTS=500
COST_PHOTO_CENTS=2
COST_LIVE_CENTS_PER_SECOND=1

# --- link import ----------------------------------------------------------

LINK_FETCH_TIMEOUT_MS=8000
LINK_MAX_BYTES=3000000
LINK_MAX_REDIRECTS=4

# --- rate limiting --------------------------------------------------------

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- feature flags --------------------------------------------------------
#
# The PRD scopes 24-hour stories to "Could have" and lists a stories feed as an
# R1 non-goal, so stories ship off. Set FLAG_STORIES=true to exercise the code
# path locally.

FLAG_LIVE_TRYON=true
FLAG_CLIP_CAPTURE=true
FLAG_STORIES=false
FLAG_LINK_IMPORT=true
FLAG_WARDROBE_UPLOAD=true
